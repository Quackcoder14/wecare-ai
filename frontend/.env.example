# WeCare.AI Frontend Environment Configuration

# Backend API base URL
# For local development with backend on same machine:
VITE_API_BASE_URL=http://localhost:8000

# For cross-laptop development (Laptop A runs backend, Laptop B runs frontend):
# Replace with Laptop A's LAN IP address (e.g., http://192.168.1.50:8000)
# Ensure backend CORS allows this origin

# Enable mock/demo mode for frontend development without backend
# Set to "true" to use synthetic data
VITE_USE_MOCK_API=false