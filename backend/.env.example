# WeCare.AI Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
DEBUG=false
ENVIRONMENT=development
APP_NAME=WeCare.AI
APP_VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000

# CORS - Comma-separated list of allowed origins
# For local development with frontend on localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For cross-laptop development, add Laptop B's origin:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.50:5173

# Database
# SQLite for development (file-based)
DATABASE_URL=sqlite:///./wecare.db
# For in-memory testing: DATABASE_URL=sqlite:///:memory:
# DATABASE_ECHO=true  # Set to true for SQL query logging

# Clinical Rules
RULES_VERSION=WHO-IITT-12PLUS-LOCAL-v1
MIN_ASSESSMENT_AGE=12

# Groq AI — LLM-powered risk assessment (llama-3.3-70b-versatile)
# Get your free API key at https://console.groq.com
# When set, Groq AI replaces the deterministic risk calculator as primary engine.
# Leave blank to use deterministic rules-only mode.
GROQ_API_KEY=

# Google Cloud Speech-to-Text Configuration
# Option 1: Service Account Key File (recommended for development)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Option 2: Application Default Credentials (for production/GCE)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Speech-to-Text Specific
GOOGLE_CLOUD_SPEECH_LOCATION=global
GOOGLE_CLOUD_SPEECH_API_VERSION=v1
SPEECH_TRANSCRIPTION_ENABLED=false  # Set to true when credentials are configured

# Audio Upload Limits
MAX_AUDIO_UPLOAD_MB=10
MAX_AUDIO_DURATION_SECONDS=60

# Supported Language Codes (comma-separated)
SUPPORTED_LANGUAGE_CODES=en-IN,ta-IN,te-IN,hi-IN

# Logging
LOG_LEVEL=INFO